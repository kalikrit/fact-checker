# === LLM ===
# GigaChat через Cloud.ru
GIGACHAT_API_KEY=your_key_here
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat

# === Search ===
# DuckDuckGo и Wikipedia не требуют ключей.
# Опционально: если захочется платный поиск
# SEARCH_API_KEY=
# SEARCH_PROVIDER=duckduckgo

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# === Database ===
DATABASE_URL=sqlite:///./data/fact_checker.db

# === Cache ===
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# === Frontend ===
VITE_API_BASE_URL=http://localhost:8000
